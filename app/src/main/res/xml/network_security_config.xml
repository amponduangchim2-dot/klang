<?xml version="1.0" encoding="utf-8"?>
<!-- Many internet radio stations still stream over plain http. Klang's own services
     (YouTube, LRCLIB, SponsorBlock, update check) all use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
