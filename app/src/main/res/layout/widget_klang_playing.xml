<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg_studio"
    android:orientation="horizontal"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/w_deck"
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:background="@drawable/w_cell_studio_tl">
            <ViewFlipper android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="150">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r00"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r01"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r02"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r03"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r04"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r05"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r06"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r07"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r08"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r09"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r10"/>
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_r11"/>
            </ViewFlipper>
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:padding="5dp" android:src="@drawable/w_disc_light"/>
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/w_arm_rest"/>
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/w_arm_on"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/w_lcdcell"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/w_cell_studio"
            android:padding="5dp">
            <FrameLayout
                android:id="@+id/w_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/w_lcd_studio"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">
                <ImageView
                    android:id="@+id/w_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitStart" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/w_keys"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
                <ImageView android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" 
                    android:background="@drawable/w_cell_studio" android:contentDescription="Previous" android:scaleType="center" android:src="@drawable/w_cap_prev_light" />
                <ImageView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                    android:background="@drawable/w_cell_studio" android:contentDescription="Pause" android:scaleType="center" android:src="@drawable/w_cap_pause_light" />
                <ImageView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" 
                    android:background="@drawable/w_cell_studio" android:contentDescription="Next" android:scaleType="center" android:src="@drawable/w_cap_next_light" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
